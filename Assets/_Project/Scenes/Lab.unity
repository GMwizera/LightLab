  m_Script: {fileID: 11500000, guid: 8738fef42a7744dcca28fd5e45b61817, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PassTheLight.Core.LevelRoot
  title: Pass it on
  tip: Light the teacher. Lit students shine where their arrows point.
  lesson: 'Glass slows light, so the beam bends as it goes through (Snell''s law).


    Students
    with gold arrows pass the light on when they are lit. Guide each one''s light
    to the next student.'
  parMoves: 8
  hintFrom: {fileID: 702622930}
  hintTo: {fileID: 1461591463}
  quizQuestion: When light passes from air into glass, it bends...
  quizOptions:
  - away from the normal
  - towards the normal
  - it does not bend
  correctOption: 1
  quizExplanation: Light slows down in glass, so it bends towards the normal.
