  m_Script: {fileID: 11500000, guid: 8738fef42a7744dcca28fd5e45b61817, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PassTheLight.Core.LevelRoot
  title: First light
  tip: Drag the mirror into the beam, then rotate it.
  lesson: 'A mirror bounces light back at the same angle it arrives.


    Angle
    in (i) = angle out (r)'
  parMoves: 4
  hintFrom: {fileID: 1899203404}
  hintTo: {fileID: 1149497145}
  quizQuestion: "A ray hits a mirror 30\xB0 from the normal. What is the angle of
    reflection?"
  quizOptions:
  - "15\xB0"
  - "30\xB0"
  - "60\xB0"
  correctOption: 1
  quizExplanation: The angle of reflection always equals the angle of incidence.
